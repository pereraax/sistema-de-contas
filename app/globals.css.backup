@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --foreground-rgb: 0, 0, 0;
  --background-start-rgb: 214, 219, 220;
  --background-end-rgb: 255, 255, 255;
  /* Cores customizadas como variáveis CSS */
  --color-primary: #00C2FF;
  --color-primary-dark: #0099CC;
  --color-primary-darker: #007A99;
  --color-dark-bg: #1a1a1a;
  --color-dark-border: #2a2a2a;
  --color-dark-text: #0D1B2A;
  --color-light-bg: #E6F7FF;
}

@media (prefers-color-scheme: dark) {
  :root {
    --foreground-rgb: 255, 255, 255;
    --background-start-rgb: 0, 0, 0;
    --background-end-rgb: 0, 0, 0;
  }
}

html {
  scroll-behavior: smooth;
}

html, body {
  height: 100%;
  min-height: 100vh;
  overflow-x: hidden !important;
  max-width: 100vw !important;
}

body {
  color: rgb(var(--foreground-rgb));
  background: linear-gradient(
      to bottom,
      transparent,
      rgb(var(--background-end-rgb))
    )
    rgb(var(--background-start-rgb));
  transition: background-color 0.3s ease;
  margin: 0;
  padding: 0;
}

/* Dark mode styles */
.dark body {
  background-color: #0D1B2A !important;
  color: #E6E6E6;
}

.dark .min-h-screen {
  background-color: #0D1B2A !important;
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
  
  .transition-smooth {
    @apply transition-all duration-300 ease-in-out;
  }
}

/* CORES CUSTOMIZADAS - Múltiplas abordagens para garantir funcionamento */
/* Abordagem 1: Seletores de atributo (funcionam sempre) - com aspas duplas E simples */
[class*="bg-[#1a1a1a]"],
[class*='bg-[#1a1a1a]'] { background-color: #1a1a1a !important; }
[class*="bg-[#2a2a2a]"],
[class*='bg-[#2a2a2a]'] { background-color: #2a2a2a !important; }
[class*="bg-[#00C2FF]"],
[class*='bg-[#00C2FF]'] { background-color: #00C2FF !important; }
[class*="bg-[#0099CC]"],
[class*='bg-[#0099CC]'] { background-color: #0099CC !important; }
[class*="bg-[#007A99]"],
[class*='bg-[#007A99]'] { background-color: #007A99 !important; }
[class*="bg-[#0D1B2A]"],
[class*='bg-[#0D1B2A]'] { background-color: #0D1B2A !important; }
[class*="bg-[#E6F7FF]"],
[class*='bg-[#E6F7FF]'] { background-color: #E6F7FF !important; }
[class*="bg-[#25D366]"],
[class*='bg-[#25D366]'] { background-color: #25D366 !important; }
[class*="bg-[#20BA5A]"],
[class*='bg-[#20BA5A]'] { background-color: #20BA5A !important; }
[class*="bg-[#00B8E6]"],
[class*='bg-[#00B8E6]'] { background-color: #00B8E6 !important; }
[class*="text-[#00C2FF]"],
[class*='text-[#00C2FF]'] { color: #00C2FF !important; }
[class*="text-[#0D1B2A]"],
[class*='text-[#0D1B2A]'] { color: #0D1B2A !important; }
[class*="border-[#00C2FF]"],
[class*='border-[#00C2FF]'] { border-color: #00C2FF !important; }
[class*="border-[#2a2a2a]"],
[class*='border-[#2a2a2a]'] { border-color: #2a2a2a !important; }

/* Classes com escape para Tailwind (processamento direto) */
.bg-\[#1a1a1a\] { background-color: #1a1a1a !important; }
.bg-\[#2a2a2a\] { background-color: #2a2a2a !important; }
.bg-\[#00C2FF\] { background-color: #00C2FF !important; }
.bg-\[#0099CC\] { background-color: #0099CC !important; }
.bg-\[#007A99\] { background-color: #007A99 !important; }
.bg-\[#0D1B2A\] { background-color: #0D1B2A !important; }
.bg-\[#E6F7FF\] { background-color: #E6F7FF !important; }
.bg-\[#25D366\] { background-color: #25D366 !important; }
.bg-\[#20BA5A\] { background-color: #20BA5A !important; }
.bg-\[#00B8E6\] { background-color: #00B8E6 !important; }
.text-\[#00C2FF\] { color: #00C2FF !important; }
.text-\[#0D1B2A\] { color: #0D1B2A !important; }
.border-\[#00C2FF\] { border-color: #00C2FF !important; }
.border-\[#2a2a2a\] { border-color: #2a2a2a !important; }
.from-\[#00C2FF\] { --tw-gradient-from: #00C2FF var(--tw-gradient-from-position, 0%); --tw-gradient-to: rgb(0 194 255 / 0) var(--tw-gradient-to-position, 100%); --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to); }
.to-\[#0099CC\] { --tw-gradient-to: #0099CC var(--tw-gradient-to-position, 100%); }
.shadow-\[#00C2FF\] { box-shadow: 0 0 0 1px rgba(0, 194, 255, 0.1); }
.hover\:bg-\[#0099CC\]:hover { background-color: #0099CC !important; }
.hover\:bg-\[#007A99\]:hover { background-color: #007A99 !important; }
.hover\:bg-\[#20BA5A\]:hover { background-color: #20BA5A !important; }
.hover\:bg-\[#00B8E6\]:hover { background-color: #00B8E6 !important; }
.hover\:shadow-\[#00C2FF\]\/30:hover { box-shadow: 0 10px 15px -3px rgba(0, 194, 255, 0.3), 0 4px 6px -2px rgba(0, 194, 255, 0.3) !important; }

/* Remover outline amarelo padrão do navegador em todos os campos de formulário */
input:focus,
textarea:focus,
select:focus {
  outline: none !important;
  outline-offset: 0 !important;
  box-shadow: none !important;
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
}

/* Garantir que não haja ring ou outline em campos focados */
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: none !important;
  outline-offset: 0 !important;
  box-shadow: none !important;
}

/* Fonte moderna para títulos com font-display - permite bold quando necessário */
.font-display {
  letter-spacing: 0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-weight: 300; /* Leve por padrão, mas pode ser sobrescrito */
}

/* Permitir font-bold com font-display para títulos em negrito */
.font-display.font-bold,
.font-bold.font-display {
  font-weight: 700 !important; /* Negrito quando explicitamente solicitado */
}

.font-display.font-semibold,
.font-semibold.font-display {
  font-weight: 600 !important; /* Semi-negrito quando explicitamente solicitado */
}

.font-display.font-medium,
.font-medium.font-display {
  font-weight: 500 !important; /* Médio quando explicitamente solicitado */
}

/* Títulos h1, h2, h3 com font-display - permitir bold quando necessário */
h1.font-display,
h2.font-display,
h3.font-display,
h4.font-display,
h5.font-display,
h6.font-display {
  font-weight: 300; /* Leve por padrão, mas pode ser sobrescrito com font-bold */
}

/* Elementos com text-2xl, text-3xl, etc. com font-display - permitir bold quando necessário */
.text-xl.font-display,
.text-2xl.font-display,
.text-3xl.font-display,
.text-4xl.font-display,
.text-5xl.font-display,
.text-6xl.font-display {
  font-weight: 300; /* Leve por padrão, mas pode ser sobrescrito com font-bold */
}

/* Animações e outras utilidades */
@layer utilities {
  .glass-backdrop {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.3) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 9998 !important;
  }
  
  .animate-fade-in {
    animation: fadeIn 0.2s ease-out;
  }

  .animate-slide-fade {
    animation: slideFade 0.5s ease-out;
  }

  .animate-slide-fade-delayed {
    animation: slideFade 0.6s ease-out;
  }

  .animate-slide-smooth {
    animation: slideSmooth 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .animate-slide-up {
    animation: slideUp 0.2s ease-out;
  }
  
  .animate-slide-down {
    animation: slideDown 0.2s ease-out;
  }
  
  .animate-scale-up {
    animation: scaleUp 0.15s ease-out;
  }
  
  .animate-scale-in {
    animation: scaleIn 0.3s ease-out;
  }
  
  .animate-bounce-slow {
    animation: bounceSlow 2s ease-in-out infinite;
  }
}

@keyframes slideFade {
  0% {
    opacity: 0;
    transform: translateX(30px) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes slideSmooth {
  0% {
    opacity: 0;
    transform: translateX(40px);
  }
  50% {
    opacity: 0.5;
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleUp {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes bounceSlow {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

.animate-shimmer {
  animation: shimmer 3s infinite;
}

/* Animação flutuante para elementos */
@keyframes float {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-10px);
  }
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

@keyframes float-subtle {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-8px);
  }
}

.animate-float-subtle {
  animation: float-subtle 3s ease-in-out infinite;
}

/* Animação de pulso customizada */
@keyframes pulse-slow {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

.animate-pulse-slow {
  animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* Animações para popup dinâmico */
@keyframes float-delayed {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-15px);
  }
}

.animate-float-delayed {
  animation: float-delayed 4s ease-in-out infinite;
  animation-delay: 1s;
}

.animate-float-1 {
  animation: float 4s ease-in-out infinite;
  animation-delay: 0s;
}

.animate-float-2 {
  animation: float 5s ease-in-out infinite;
  animation-delay: 1.5s;
}

.animate-float-3 {
  animation: float 4.5s ease-in-out infinite;
  animation-delay: 2.5s;
}

@keyframes twinkle {
  0%, 100% {
    opacity: 0.3;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.animate-twinkle {
  animation: twinkle 2s ease-in-out infinite;
}

.animate-twinkle-delayed {
  animation: twinkle 2s ease-in-out infinite;
  animation-delay: 0.5s;
}

.animate-twinkle-delayed-2 {
  animation: twinkle 2s ease-in-out infinite;
  animation-delay: 1s;
}

/* Animação para checkbox moderno */
@keyframes checkboxCheck {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  50% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.animate-checkbox-check {
  animation: checkboxCheck 0.2s ease-out;
}

@keyframes bounce-subtle {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-5px);
  }
}

.animate-bounce-subtle {
  animation: bounce-subtle 2s ease-in-out infinite;
}

@keyframes slide-in-left {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.animate-slide-in-left {
  animation: slide-in-left 0.5s ease-out;
}

@keyframes slide-in-from-left {
  from {
    opacity: 0;
    transform: translateX(-100%);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.animate-slide-in-from-left {
  animation: slide-in-from-left 0.3s ease-out;
}

@keyframes slide-in-right {
  from {
    opacity: 0;
    transform: translateX(30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.animate-slide-in-right {
  animation: slide-in-right 0.5s ease-out;
  animation-delay: 0.1s;
  animation-fill-mode: both;
}

@keyframes slide-in-up {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-slide-in-up {
  animation: slide-in-up 0.6s ease-out;
  animation-delay: 0.2s;
  animation-fill-mode: both;
}

@keyframes pulse-subtle {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.05);
  }
}

.animate-pulse-subtle {
  animation: pulse-subtle 2s ease-in-out infinite;
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

.animate-shimmer {
  animation: shimmer 3s ease-in-out infinite;
}

/* Animação de ondas sonoras para microfone */
@keyframes soundWave {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  50% {
    transform: scale(1.5);
    opacity: 0.6;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.animate-sound-wave {
  animation: soundWave 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

.animate-sound-wave-delayed {
  animation: soundWave 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  animation-delay: 0.4s;
}

/* Animação de abertura do PLEN */
@keyframes plenOpen {
  0% {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
  }
  50% {
    transform: translateY(-5px) scale(1.02);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.animate-plen-open {
  animation: plenOpen 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* Animação de rotação suave para o botão PLEN */
@keyframes plenRotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.animate-plen-rotate {
  animation: plenRotate 8s linear infinite;
}

/* Animação de brilho (shimmer) para o botão PLEN */
@keyframes plenShine {
  0% {
    background-position: -200% center;
  }
  100% {
    background-position: 200% center;
  }
}

.animate-plen-shine {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.3) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  background-size: 200% 100%;
  animation: plenShine 3s ease-in-out infinite;
  background-clip: padding-box;
}

/* Animação de glow (brilho) pulsante para o botão PLEN */
@keyframes plenGlow {
  0%, 100% {
    box-shadow: 0 0 20px rgba(0, 183, 255, 0.4),
                0 0 40px rgba(0, 183, 255, 0.2),
                0 0 60px rgba(0, 183, 255, 0.1);
  }
  50% {
    box-shadow: 0 0 30px rgba(0, 183, 255, 0.6),
                0 0 60px rgba(0, 183, 255, 0.4),
                0 0 90px rgba(0, 183, 255, 0.2);
  }
}

.animate-plen-glow {
  animation: plenGlow 2s ease-in-out infinite;
}

/* Animação combinada para o botão PLEN - rotação + brilho */
@keyframes plenRare {
  0% {
    transform: rotate(0deg) scale(1);
    filter: brightness(1) drop-shadow(0 0 20px rgba(0, 183, 255, 0.4));
  }
  25% {
    filter: brightness(1.2) drop-shadow(0 0 30px rgba(0, 183, 255, 0.6));
  }
  50% {
    transform: rotate(180deg) scale(1.05);
    filter: brightness(1.1) drop-shadow(0 0 25px rgba(0, 183, 255, 0.5));
  }
  75% {
    filter: brightness(1.2) drop-shadow(0 0 30px rgba(0, 183, 255, 0.6));
  }
  100% {
    transform: rotate(360deg) scale(1);
    filter: brightness(1) drop-shadow(0 0 20px rgba(0, 183, 255, 0.4));
  }
}

.animate-plen-rare {
  animation: plenRare 6s ease-in-out infinite;
}

/* Esconder barra de rolagem mas manter funcionalidade */
.scrollbar-hide {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

.scrollbar-hide::-webkit-scrollbar {
  display: none;  /* Chrome, Safari and Opera */
}

/* Esconder todas as barras de rolagem globalmente */
* {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

*::-webkit-scrollbar {
  display: none;  /* Chrome, Safari and Opera */
}

/* Garantir que elementos com overflow ainda possam rolar */
html, body {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

html::-webkit-scrollbar,
body::-webkit-scrollbar {
  display: none;
}

/* Scrollbar customizado para notificações */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
  display: block;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
  border-radius: 10px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(0, 183, 255, 0.3);
  border-radius: 10px;
  transition: background 0.3s;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 183, 255, 0.5);
}

/* Animações para notificações */
@keyframes slide-in-right {
  from {
    opacity: 0;
    transform: translateX(30px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.animate-slide-in-right {
  animation: slide-in-right 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* Efeito de brilho para notificações não lidas */
@keyframes notification-glow {
  0%, 100% {
    box-shadow: 0 0 10px rgba(0, 183, 255, 0.2);
  }
  50% {
    box-shadow: 0 0 20px rgba(0, 183, 255, 0.4);
  }
}

.animate-notification-glow {
  animation: notification-glow 2s ease-in-out infinite;
}

/* Gradient animation */
@keyframes gradient {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

.animate-gradient {
  background-size: 200% 200%;
  animation: gradient 3s ease infinite;
}
