# Copie para .env.local e preencha. NÃO commite .env.local.
# Em produção (Railway/Render), defina as variáveis no painel.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Corrige erro "Failed to find Server Action" / "reading workers" em produção.
# Gere uma vez: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Defina no ambiente de produção (build time) e mantenha a mesma chave em todos os deploys.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# API Fácil WhatsApp
APIFACIL_INSTANCE_ID=
APIFACIL_TOKEN=

# Groq: comprovantes (visão) + áudio (Whisper). Recomendado.
GROQ_API_KEY=
# Alternativas (opcional)
# GEMINI_API_KEY=
# OpenAI: validação de nome no cadastro WhatsApp (extrair "João" de "Meu nome é João", rejeitar "Ss/sim")
OPENAI_API_KEY=

# Opcional: números permitidos em modo teste (webhook local)
# WHATSAPP_TEST_NUMBERS=5511999999999

# Email: link de confirmação (cadastro). Use Resend (recomendado) ou SMTP.
# Resend: https://resend.com - API Key em Dashboard > API Keys. Free tier ~3000/mês.
# RESEND_API_KEY=
# RESEND_FROM=PleniPay <noreply@seu-dominio.com>
# SMTP (alternativa): SMTP_HOST=, SMTP_PORT=587, SMTP_USER=, SMTP_PASSWORD=, SMTP_FROM= (opcional)

# Cron: checagem a cada 1 minuto para enviar boas-vindas a quem ficou de fora (webhook falhou)
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
